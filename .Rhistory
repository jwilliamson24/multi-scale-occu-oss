# Simple comparison showing CI widths
original %>%
mutate(CI_width = round(UCI - LCI, 3)) %>%
select(year, treatment, CI_width) %>%
arrange(year, treatment)
library(ggplot2)
library(dplyr)
df %>%
mutate(CI_width = UCI - LCI) %>%
ggplot(aes(x = factor(year), y = CI_width, fill = treatment)) +
geom_col(position = "dodge") +
labs(title = "CI Width Comparison by Treatment and Year",
x = "Year", y = "CI Width") +
theme_minimal()
library(ggplot2)
library(dplyr)
original %>%
mutate(CI_width = UCI - LCI) %>%
ggplot(aes(x = factor(year), y = CI_width, fill = treatment)) +
geom_col(position = "dodge") +
labs(title = "CI Width Comparison by Treatment and Year",
x = "Year", y = "CI Width") +
theme_minimal()
library(ggplot2)
library(dplyr)
# Add model identifier to each dataframe
original$model <- "Original"
withdwd$model <- "With DWD"
withdwdchar$model <- "With DWD Char"
# Combine all dataframes
combined_df <- rbind(original, withdwd, withdwdchar)
# Create the comparison plot
combined_df %>%
mutate(CI_width = UCI - LCI) %>%
ggplot(aes(x = factor(year), y = CI_width, fill = treatment)) +
geom_col(position = "dodge") +
facet_wrap(~model) +
labs(title = "CI Width Comparison Across Models",
x = "Year", y = "CI Width") +
theme_minimal()
combined_df %>%
mutate(CI_width = UCI - LCI) %>%
ggplot(aes(x = model, y = CI_width, fill = factor(year))) +
geom_col(position = "dodge") +
facet_wrap(~treatment) +
labs(title = "CI Width by Model and Treatment",
x = "Model", y = "CI Width") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
combined_df %>%
mutate(CI_width = UCI - LCI) %>%
ggplot(aes(x = factor(year), y = CI_width, color = model, group = model)) +
geom_line() +
geom_point() +
facet_wrap(~treatment) +
labs(title = "CI Width Trends Across Models",
x = "Year", y = "CI Width") +
theme_minimal()
combined_df %>%
mutate(CI_width = UCI - LCI) %>%
group_by(model, treatment) %>%
summarise(mean_CI_width = round(mean(CI_width), 3), .groups = 'drop') %>%
pivot_wider(names_from = model, values_from = mean_CI_width)
library(tidyr)
combined_df %>%
mutate(CI_width = UCI - LCI) %>%
group_by(model, treatment) %>%
summarise(mean_CI_width = round(mean(CI_width), 3), .groups = 'drop') %>%
pivot_wider(names_from = model, values_from = mean_CI_width)
as.data.frame(combined_df)
