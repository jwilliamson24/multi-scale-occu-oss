treatment_code <- gsub(".*\\.(\\w+)$", "\\1", param_name)  # Extract treatment code
treatment_occupancy <- plogis(intercept + treatment_effects$Mean[i])
percent_change <- ((treatment_occupancy - ref_occupancy) / ref_occupancy) * 100
cat(treatment_code, "treatment occupancy:", round(treatment_occupancy * 100, 1), "% (",
round(percent_change, 1), "% change from reference)\n")
}
}
# RAW DATA occupancy rates from survey data for comparison
observed_rates <- oss_dets %>%
group_by(trt) %>%
summarise(
sites = n(),
occupied = sum(detected),
occupancy_rate = round(occupied/sites * 100, 1),
.groups = 'drop'
) %>%
arrange(desc(occupancy_rate))
cat("\n=== OBSERVED OCCUPANCY RATES FROM DATA ===\n")
as.data.frame(observed_rates)
