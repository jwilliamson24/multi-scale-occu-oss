(0.3926851+0.4080180)/2
# View the table
print(summary_table_o)
as.data.frame(observed_rates)
treatment_effects <- summary_table_e[grepl("beta.*psi\\.(BU|HB|HU|BS)", summary_table_e$Parameter), ]
if(nrow(treatment_effects) > 0) {
treatment_effects$Odds_Ratio <- exp(treatment_effects$Mean)
treatment_effects$OR_CI_2.5 <- exp(treatment_effects$CI_2.5)
treatment_effects$OR_CI_97.5 <- exp(treatment_effects$CI_97.5)
cat("\n=== TREATMENT EFFECTS - ODDS RATIOS ===\n")
print(treatment_effects[, c("Parameter", "Mean", "Odds_Ratio", "OR_CI_2.5", "OR_CI_97.5", "Percent_Neg")])
}
# Calculate predicted occupancy probabilities for each treatment
# Assuming beta0.psi is the intercept
if("beta0.psi" %in% summary_table_e$Parameter) {
intercept <- summary_table_e$Mean[summary_table_e$Parameter == "beta0.psi"]
# Reference treatment occupancy (assuming intercept represents reference)
ref_occupancy <- plogis(intercept)
cat("\n=== PREDICTED OCCUPANCY RATES ===\n")
cat("Reference treatment occupancy:", round(ref_occupancy * 100, 1), "%\n")
# Calculate occupancy for each treatment
for(i in 1:nrow(treatment_effects)) {
param_name <- treatment_effects$Parameter[i]
treatment_code <- gsub(".*\\.(\\w+)$", "\\1", param_name)  # Extract treatment code
treatment_occupancy <- plogis(intercept + treatment_effects$Mean[i])
percent_change <- ((treatment_occupancy - ref_occupancy) / ref_occupancy) * 100
cat(treatment_code, "treatment occupancy:", round(treatment_occupancy * 100, 1), "% (",
round(percent_change, 1), "% change from reference)\n")
}
}
# RAW DATA occupancy rates from survey data for comparison
observed_rates <- enes_dets %>%
group_by(trt) %>%
summarise(
sites = n(),
occupied = sum(detected),
occupancy_rate = round(occupied/sites * 100, 1),
.groups = 'drop'
) %>%
arrange(desc(occupancy_rate))
cat("\n=== OBSERVED OCCUPANCY RATES FROM DATA ===\n")
as.data.frame(observed_rates)
