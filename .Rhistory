if(nrow(treatment_effects) > 0) {
treatment_effects$Odds_Ratio <- exp(treatment_effects$Mean)
treatment_effects$OR_CI_2.5 <- exp(treatment_effects$CI_2.5)
treatment_effects$OR_CI_97.5 <- exp(treatment_effects$CI_97.5)
cat("\n=== TREATMENT EFFECTS - ODDS RATIOS ===\n")
